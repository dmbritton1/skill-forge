 def response_text(resp):
-    if isinstance(resp, str):
-        return resp[:MAX_OUTPUT_CHARS]
-    try:
-        return json.dumps(resp, default=str)[:MAX_OUTPUT_CHARS]
-    except (TypeError, ValueError):
-        return str(resp)[:MAX_OUTPUT_CHARS]
+    """Return searchable text for a PostToolUse tool_response.
+
+    `resp` is whatever the harness put in tool_response: a plain string for
+    some tools, and for most tools a structured object.
+
+    The result is handed to patterns.tokenize() and matched against
+    anti-skill symptom patterns. Truncate the result to MAX_OUTPUT_CHARS.
+
+    Structured responses are flattened to their leaf values, never
+    serialized: json.dumps() writes a newline as backslash-n, and the
+    tokenizer glues that `n` onto the next line's first word, so a signature
+    below line one silently stops matching. Dict keys are envelope names, not
+    error text, so they are dropped -- every one of them would spend tokens
+    out of the matcher's bounded gap window.
+    """
+    def flatten(node, depth):
+        if isinstance(node, str):
+            return node[:MAX_OUTPUT_CHARS]
+        if depth < MAX_RESPONSE_DEPTH:
+            if isinstance(node, dict):
+                node = list(node.values())
+            if isinstance(node, (list, tuple)):
+                return "\n".join(flatten(v, depth + 1) for v in node)[:MAX_OUTPUT_CHARS]
+        return str(node)[:MAX_OUTPUT_CHARS]
+
+    return flatten(resp, 0)
 
 
 def run(data):
