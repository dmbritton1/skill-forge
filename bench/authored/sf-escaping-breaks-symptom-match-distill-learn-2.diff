 def response_text(resp):
+    """The response's string leaves, newline-joined.
+
+    Never json.dumps(): it escapes a real newline to a literal backslash-n
+    that the tokenizer welds onto the next line's first token, so a symptom
+    starting a line -- the normal shape of an error signature -- silently
+    stops matching.
+    """
     if isinstance(resp, str):
         return resp[:MAX_OUTPUT_CHARS]
+    out = []
     try:
-        return json.dumps(resp, default=str)[:MAX_OUTPUT_CHARS]
-    except (TypeError, ValueError):
+        _strings(resp, out)
+    except RecursionError:
         return str(resp)[:MAX_OUTPUT_CHARS]
+    return "\n".join(out)[:MAX_OUTPUT_CHARS]
 
 
