diff --git a/scripts/detect.py b/scripts/detect.py
index c92dbbd..ecbb740 100644
--- a/scripts/detect.py
+++ b/scripts/detect.py
@@ -25,6 +25,8 @@ import trust
 
 MAX_OUTPUT_CHARS = 64 * 1024
 MAX_ANTISKILLS = 2
+# ponytail: fixed depth cap so a pathological response cannot blow the stack.
+MAX_DEPTH = 8
 INJECT_BUDGET_TOKENS = 1200
 
 
@@ -62,13 +64,39 @@ def _log(*args, **kwargs):
 
 
 def response_text(resp):
-    if isinstance(resp, str):
-        return resp[:MAX_OUTPUT_CHARS]
-    try:
-        return json.dumps(resp, default=str)[:MAX_OUTPUT_CHARS]
-    except (TypeError, ValueError):
-        return str(resp)[:MAX_OUTPUT_CHARS]
+    """Return searchable text for a PostToolUse tool_response.
+
+    `resp` is whatever the harness put in tool_response: a plain string for
+    some tools, and for most tools a structured object.
 
+    The result is handed to patterns.tokenize() and matched against
+    anti-skill symptom patterns. Truncate the result to MAX_OUTPUT_CHARS.
+
+    Flatten, never serialize: json.dumps/repr escape a real newline into the
+    two characters backslash-n, and tokenize() then reads that `n` as part of
+    the next word -- every signature starting a line silently stops matching.
+    """
+    parts = []
+    size = 0
+
+    def walk(v, depth):
+        nonlocal size
+        if size >= MAX_OUTPUT_CHARS or depth > MAX_DEPTH:
+            return
+        if isinstance(v, dict):
+            for k, item in v.items():
+                walk(k, depth + 1)
+                walk(item, depth + 1)
+        elif isinstance(v, (list, tuple, set)):
+            for item in v:
+                walk(item, depth + 1)
+        else:
+            s = v if isinstance(v, str) else str(v)
+            parts.append(s)
+            size += len(s) + 1
+
+    walk(resp, 0)
+    return "\n".join(parts)[:MAX_OUTPUT_CHARS]
 
 def run(data):
     idx = load_triggers()
