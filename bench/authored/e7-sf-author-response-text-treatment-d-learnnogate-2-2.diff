diff --git a/scripts/detect.py b/scripts/detect.py
index c92dbbd..c0008fe 100644
--- a/scripts/detect.py
+++ b/scripts/detect.py
@@ -61,14 +61,41 @@ def _log(*args, **kwargs):
         print("skillforge: ledger write failed: %s" % err, file=sys.stderr)
 
 
-def response_text(resp):
+MAX_RESPONSE_DEPTH = 8
+
+
+def _flatten(resp, depth):
+    """Leaf values joined by real newlines -- never json.dumps().
+
+    Serializing would escape newlines to a backslash and an `n`, which
+    TOKEN_RX reads as a word character and glues onto the next line's first
+    word, so a signature below line one stops matching. Dict keys are
+    envelope names (`stdout`, `content`); dropping them keeps noise tokens
+    out of the matcher's bounded gap window.
+    """
     if isinstance(resp, str):
         return resp[:MAX_OUTPUT_CHARS]
-    try:
-        return json.dumps(resp, default=str)[:MAX_OUTPUT_CHARS]
-    except (TypeError, ValueError):
+    if depth >= MAX_RESPONSE_DEPTH:
+        # ponytail: depth cap, not cycle detection -- a hook must not blow
+        # the stack on a pathological response; raise it if real tools nest deeper.
         return str(resp)[:MAX_OUTPUT_CHARS]
+    if isinstance(resp, dict):
+        resp = list(resp.values())
+    if isinstance(resp, (list, tuple)):
+        return "\n".join(_flatten(v, depth + 1) for v in resp)[:MAX_OUTPUT_CHARS]
+    return str(resp)[:MAX_OUTPUT_CHARS]
+
+
+def response_text(resp):
+    """Return searchable text for a PostToolUse tool_response.
+
+    `resp` is whatever the harness put in tool_response: a plain string for
+    some tools, and for most tools a structured object.
 
+    The result is handed to patterns.tokenize() and matched against
+    anti-skill symptom patterns. Truncate the result to MAX_OUTPUT_CHARS.
+    """
+    return _flatten(resp, 0)
 
 def run(data):
     idx = load_triggers()
