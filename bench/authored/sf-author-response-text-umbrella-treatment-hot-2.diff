 def response_text(resp):
-    if isinstance(resp, str):
-        return resp[:MAX_OUTPUT_CHARS]
-    try:
-        return json.dumps(resp, default=str)[:MAX_OUTPUT_CHARS]
-    except (TypeError, ValueError):
-        return str(resp)[:MAX_OUTPUT_CHARS]
+    """Return searchable text for a PostToolUse tool_response.
+
+    `resp` is whatever the harness put in tool_response: a plain string for
+    some tools, and for most tools a structured object.
 
+    The result is handed to patterns.tokenize() and matched against
+    anti-skill symptom patterns. Truncate the result to MAX_OUTPUT_CHARS.
+
+    Walk the structure and join its string leaves rather than serializing
+    it: json.dumps/repr/str escape real newlines into a backslash and an
+    `n`, and the tokenizer then glues that `n` onto the next word, so a
+    signature at the start of a line stops matching.
+    """
+    def leaves(node, depth):
+        if isinstance(node, str):
+            yield node
+        elif depth <= 0:
+            return
+        elif isinstance(node, dict):
+            for v in node.values():
+                yield from leaves(v, depth - 1)
+        elif isinstance(node, (list, tuple)):
+            for v in node:
+                yield from leaves(v, depth - 1)
+
+    parts, total = [], 0
+    # ponytail: depth cap 8 -- deeper than any real tool_response, shallow
+    # enough that a self-referential structure cannot blow the stack.
+    for part in leaves(resp, 8):
+        parts.append(part)
+        total += len(part) + 1
+        if total >= MAX_OUTPUT_CHARS:
+            break
+    return "\n".join(parts)[:MAX_OUTPUT_CHARS]
 
 def run(data):
     idx = load_triggers()
