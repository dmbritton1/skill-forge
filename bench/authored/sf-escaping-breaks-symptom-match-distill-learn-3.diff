+def snapshot(fingerprints, cwd, probes_left):
+    """Fingerprint snapshot under a per-call probe budget -> (value, probes_left).
+
+    One place for the budget rule, shared by the prompt and symptom hooks.
+    """
+    if not fingerprints or len(fingerprints) > probes_left:
+        return None, probes_left
+    return fingerprint_preexisting(fingerprints, cwd), probes_left - len(fingerprints)
+
