-    except (TypeError, ValueError):
-        return str(resp)[:MAX_OUTPUT_CHARS]
+    """Flatten a tool response to raw text for matching.
+
+    ponytail: no json.dumps. It escapes real newlines to backslash-n, and
+    the tokenizer then glues that "n" onto the next line's first token --
+    silently defeating every symptom whose signature starts a line.
+    """
+    parts = []
+    total = 0
+    for s in _strings(resp):
+        parts.append(s)
+        total += len(s) + 1
+        if total >= MAX_OUTPUT_CHARS:
+            break
+    return "\n".join(parts)[:MAX_OUTPUT_CHARS]
 
 
