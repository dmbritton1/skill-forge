+def _strings(obj):
+    """Every leaf of a tool response, in order, as raw text."""
+    if isinstance(obj, str):
+        yield obj
+    elif isinstance(obj, dict):
+        for v in obj.values():
+            yield from _strings(v)
+    elif isinstance(obj, (list, tuple)):
+        for v in obj:
+            yield from _strings(v)
+    else:
+        yield str(obj)
+
