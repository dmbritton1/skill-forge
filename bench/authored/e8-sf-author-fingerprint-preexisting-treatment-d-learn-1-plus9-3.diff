+def _git_grep_files(tokens, cwd):
+    """Files containing every token, [] if none, None if git couldn't answer."""
+    cmd = ["git", "grep", "-l", "-i", "-F", "--all-match"]
+    for t in tokens:
+        cmd += ["-e", t]
+    try:
+        p = subprocess.run(cmd, cwd=cwd, capture_output=True, text=True,
+                           timeout=GIT_TIMEOUT_S)
+    except (OSError, subprocess.SubprocessError):
+        return None            # git missing, or the timeout fired
+    if p.returncode == 1:
+        return []              # ran fine, matched nothing
+    if p.returncode != 0:
+        return None            # not a repo, or git gave up
+    return [line for line in p.stdout.splitlines() if line]
+
