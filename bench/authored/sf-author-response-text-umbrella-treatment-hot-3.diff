--- a/scripts/detect.py
+++ b/scripts/detect.py
@@ -26,6 +26,7 @@ import trust
 MAX_OUTPUT_CHARS = 64 * 1024
 MAX_ANTISKILLS = 2
 INJECT_BUDGET_TOKENS = 1200
+MAX_DEPTH = 6
 
 
 def triggers_path():
@@ -62,13 +63,39 @@ def _log(*args, **kwargs):
 
 
 def response_text(resp):
-    if isinstance(resp, str):
-        return resp[:MAX_OUTPUT_CHARS]
-    try:
-        return json.dumps(resp, default=str)[:MAX_OUTPUT_CHARS]
-    except (TypeError, ValueError):
-        return str(resp)[:MAX_OUTPUT_CHARS]
+    """Return searchable text for a PostToolUse tool_response.
+
+    `resp` is whatever the harness put in tool_response: a plain string for
+    some tools, and for most tools a structured object.
 
+    The result is handed to patterns.tokenize() and matched against
+    anti-skill symptom patterns. Truncate the result to MAX_OUTPUT_CHARS.
+
+    Flattened by walking the structure, never serialized: json.dumps/repr/str
+    escape control characters, so a real newline arrives as backslash-n and
+    the tokenizer glues that `n` onto the next word -- every symptom whose
+    first token starts a line would silently stop matching.
+    """
+    parts = []
+
+    def walk(node, depth):
+        if isinstance(node, str):
+            parts.append(node)
+        elif depth >= MAX_DEPTH:
+            # ponytail: escaped fallback past the depth cap -- some signal
+            # beats none that deep, and real tool output is never nested here.
+            parts.append(str(node))
+        elif isinstance(node, dict):
+            for value in node.values():
+                walk(value, depth + 1)
+        elif isinstance(node, (list, tuple)):
+            for value in node:
+                walk(value, depth + 1)
+        else:
+            parts.append(str(node))
+
+    walk(resp, 0)
+    return "\n".join(parts)[:MAX_OUTPUT_CHARS]
 
 def run(data):
     idx = load_triggers()
