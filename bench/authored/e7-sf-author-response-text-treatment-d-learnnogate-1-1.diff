 def response_text(resp):
-    if isinstance(resp, str):
-        return resp[:MAX_OUTPUT_CHARS]
-    try:
-        return json.dumps(resp, default=str)[:MAX_OUTPUT_CHARS]
-    except (TypeError, ValueError):
-        return str(resp)[:MAX_OUTPUT_CHARS]
+    """Return searchable text for a PostToolUse tool_response.
+
+    `resp` is whatever the harness put in tool_response: a plain string for
+    some tools, and for most tools a structured object.
 
+    The result is handed to patterns.tokenize() and matched against
+    anti-skill symptom patterns. Truncate the result to MAX_OUTPUT_CHARS.
+    """
+    # Never json.dumps here: it escapes a real newline to backslash-n, and
+    # TOKEN_RX then glues the "n" onto the next word, so any signature that
+    # starts a line can never match. Walk to the string leaves instead.
+    return "\n".join(_leaf_strings(resp))[:MAX_OUTPUT_CHARS]
+
+
+def _leaf_strings(obj):
+    """Yield every scalar leaf of a nested payload as text, in order."""
+    if isinstance(obj, dict):
+        for v in obj.values():
+            yield from _leaf_strings(v)
+    elif isinstance(obj, (list, tuple)):
+        for v in obj:
+            yield from _leaf_strings(v)
+    elif isinstance(obj, str):
+        yield obj
+    elif obj is not None:
+        yield str(obj)
 
 def run(data):
     idx = load_triggers()
