 def response_text(resp):
+    """Return searchable text for a PostToolUse tool_response.
+
+    `resp` is whatever the harness put in tool_response: a plain string for
+    some tools, and for most tools a structured object.
+
+    The result is handed to patterns.tokenize() and matched against
+    anti-skill symptom patterns. Truncate the result to MAX_OUTPUT_CHARS.
+    """
     if isinstance(resp, str):
         return resp[:MAX_OUTPUT_CHARS]
-    try:
-        return json.dumps(resp, default=str)[:MAX_OUTPUT_CHARS]
-    except (TypeError, ValueError):
-        return str(resp)[:MAX_OUTPUT_CHARS]
+    # ponytail: collect string leaves instead of json.dumps/repr. A serializer
+    # escapes a real newline into backslash-n, and tokenize() then reads that
+    # `n` as a word character glued to the next token -- symptoms that start a
+    # line silently stop matching. Joining leaves with a real separator keeps
+    # the original bytes.
+    parts, size = [], 0
+    for leaf in _leaves(resp, 0):
+        parts.append(leaf)
+        size += len(leaf) + 1
+        if size >= MAX_OUTPUT_CHARS:
+            break
+    return "\n".join(parts)[:MAX_OUTPUT_CHARS]
+
+
+MAX_DEPTH = 8
+
+
+def _leaves(node, depth):
+    """Yield the string leaves of a nested response, depth-capped."""
+    if isinstance(node, str):
+        yield node
+    elif isinstance(node, dict):
+        if depth < MAX_DEPTH:
+            for v in node.values():
+                yield from _leaves(v, depth + 1)
+    elif isinstance(node, (list, tuple, set)):
+        if depth < MAX_DEPTH:
+            for v in node:
+                yield from _leaves(v, depth + 1)
+    elif node is not None:
+        yield str(node)
 
 
 def run(data):
