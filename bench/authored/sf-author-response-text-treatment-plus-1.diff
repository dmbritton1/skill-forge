+                          "WidgetFlushedError: the widget was already flushed"}
+        data = {"session_id": "sess1", "cwd": str(home), "tool_name": "Bash",
+                "tool_input": {"command": ""}, "tool_response": resp}
+        rc, out = run_capture(data)
+        assert injected_names(out) == ["widget-trap"]
+    in_sandbox(check)
